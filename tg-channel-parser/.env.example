# Telegram MTProto (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_2FA_PASSWORD=
TELEGRAM_SESSION_STRING=

# Database (isolated tg_parser DB — never share with zakupki)
POSTGRES_USER=tg_parser
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=tg_parser
DATABASE_URL=postgresql+asyncpg://tg_parser:change-me-now@tg-parser-postgres:5432/tg_parser
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Media storage
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_PATH=/data/media
MEDIA_TMP_PATH=/tmp/media

# Worker
TASK_POLL_INTERVAL_SECONDS=2
MEDIA_MAX_RETRIES=3
MEDIA_RETRY_BACKOFF_BASE_SECONDS=5
TASK_STALE_PROCESSING_MINUTES=15
MAX_MEDIA_BYTES=52428800

# Backend API (must match PARSER_API_TOKEN in zakupki .env)
API_AUTH_TOKEN=

# Misc
TZ=Europe/Moscow
LOG_LEVEL=INFO
