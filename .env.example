# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required for webhook/job failure alerts (otherwise alerts are silent no-ops).
ADMIN_ALERT_CHAT_ID=
# Fallback for daily/weekly reports when no owner has dm_ok=true.
ANALYTICS_CHAT_ID=
# openssl rand -hex 32; charset A-Za-z0-9_- (Telegram setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Backend
# Public HTTPS URL used when calling setWebhook (ops); optional at runtime.
PUBLIC_BACKEND_URL=
WEBHOOK_SECRET=
# setWebhook must include callback_query and my_chat_member for the owner menu
# and supplier-group auto-binding to work:
#   allowed_updates=["message","edited_message","callback_query","my_chat_member"]
# Bot must be admin in every supplier group, otherwise Privacy Mode hides replies.
# Set false on extra replicas/workers so only one process runs cron.
SCHEDULER_ENABLED=true
CONFIDENCE_THRESHOLD=0.75
# Also used as Settings.tz for APScheduler cron (Europe/Moscow).
TZ=Europe/Moscow
LOG_LEVEL=INFO
WEBHOOK_MAX_BODY_BYTES=262144
MAX_MESSAGE_TEXT_LEN=4000
# Set false in production to hide /docs, /redoc, and /openapi.json.
DOCS_ENABLED=true
# Preferred: CSV of chat ids, several approvers get the notification.
PRICE_APPROVAL_CHAT_IDS=
# Legacy single-chat fallback, still supported if CHAT_IDS is empty.
PRICE_APPROVAL_CHAT_ID=
PRICE_PUBLISH_CHAT_IDS=
DEFAULT_MARKUP=500
PARSER_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
LLM_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Database
# Primary: Supabase project BOT_SALLER (ref tdssydlefjxoaljdcxpo).
# Password: Dashboard → Project Settings → Database (never commit real password).
# Direct (asyncpg):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.tdssydlefjxoaljdcxpo.supabase.co:5432/postgres
# Prefer pooler URL from Dashboard for serverless/many connections; keep +asyncpg scheme.
#
# Optional local Docker postgres (docker-compose service `postgres`):
POSTGRES_USER=zakupki
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=zakupki
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.tdssydlefjxoaljdcxpo.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
# Scheduler uses a dedicated small pool so long jobs cannot starve web workers.
DB_SCHEDULER_POOL_SIZE=2
DB_SCHEDULER_MAX_OVERFLOW=3
DB_SCHEDULER_POOL_TIMEOUT=30

# Test database (used by pytest; same host/credentials as DATABASE_URL, separate DB name).
TEST_DATABASE_URL=postgresql+asyncpg://zakupki:change-me-now@127.0.0.1:5432/zakupki_test

# LLM
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=

# LLM billing reminder (monthly; 1-28 to avoid months shorter than 31 days).
# Update price text without restart via owner command /set_llm_price.
LLM_PROVIDER_NAME=DeepSeek
LLM_TOPUP_PRICE_TEXT="рекомендуемое пополнение: 500 CNY / ~$0.14 за 1M input токенов"
LLM_TOPUP_PAYMENT_URL=https://platform.deepseek.com/top_up
LLM_BILLING_REMINDER_CHAT_ID=
LLM_BILLING_REMINDER_DAY=1

# Сервис парсинга каналов (отдельный! см. СЕРВИСЫ.md и tg-channel-parser/README.md)
# Local: http://127.0.0.1:8081  |  shared Docker network: http://tg-parser-api:8000
# PARSER_API_TOKEN == API_AUTH_TOKEN из tg-channel-parser/.env (не TELEGRAM_BOT_TOKEN)
# Бот теперь пишет сюда: GET /posts, POST /channels, DELETE /channels/{id}
PARSER_API_URL=http://127.0.0.1:8081
PARSER_API_TOKEN=

# seed_demo.py (optional)
SEED_OWNER_TELEGRAM_ID=
SEED_OWNER_NAME=
SEED_EMPLOYEE_TELEGRAM_ID=
SEED_EMPLOYEE_NAME=
SEED_SUPPLIER_TELEGRAM_ID=
SEED_SUPPLIER_NAME=
SEED_SUPPLIER_PRICE_CHANNEL_ID=
SEED_SUPPLIER_PRICE_CHANNEL_USERNAME=
SEED_CLIENT_GROUP_CHAT_ID=
SEED_CLIENT_GROUP_TITLE=
