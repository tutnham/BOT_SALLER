# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required for webhook/job failure alerts (otherwise alerts are silent no-ops).
ADMIN_ALERT_CHAT_ID=
# Fallback for daily/weekly reports when no owner has dm_ok=true.
ANALYTICS_CHAT_ID=
# openssl rand -hex 32; charset A-Za-z0-9_- (Telegram setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Backend
# Public HTTPS URL used when calling setWebhook (ops); optional at runtime.
PUBLIC_BACKEND_URL=
WEBHOOK_SECRET=
# Set false on extra replicas/workers so only one process runs cron.
SCHEDULER_ENABLED=true
CONFIDENCE_THRESHOLD=0.75
# Also used as Settings.tz for APScheduler cron (Europe/Moscow).
TZ=Europe/Moscow
LOG_LEVEL=INFO
WEBHOOK_MAX_BODY_BYTES=262144
MAX_MESSAGE_TEXT_LEN=4000
PRICE_APPROVAL_CHAT_ID=
PRICE_PUBLISH_CHAT_IDS=
DEFAULT_MARKUP=500
PARSER_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
LLM_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Database
POSTGRES_USER=zakupki
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=zakupki
DATABASE_URL=postgresql+asyncpg://zakupki:change-me-now@postgres:5432/zakupki
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# LLM
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=

# Сервис парсинга каналов поставщиков (см. TG_CHANNEL_PARSER_DOCUMENTATION.md, раздел 9.5.1)
PARSER_API_URL=http://tg-parser-api:8100
PARSER_API_TOKEN=

# seed_demo.py (optional)
SEED_OWNER_TELEGRAM_ID=
SEED_OWNER_NAME=
SEED_EMPLOYEE_TELEGRAM_ID=
SEED_EMPLOYEE_NAME=
SEED_SUPPLIER_TELEGRAM_ID=
SEED_SUPPLIER_NAME=
SEED_SUPPLIER_PRICE_CHANNEL_ID=
SEED_SUPPLIER_PRICE_CHANNEL_USERNAME=
SEED_CLIENT_GROUP_CHAT_ID=
SEED_CLIENT_GROUP_TITLE=
